{
    "name": "coloredtheme",
    "displayName": "Colored Theme",
    "description": "Mainly changes the color of the top and left bars to identify multiple instances at a glance. Add Arduino theme.",
    "icon": "logo.png",
    "publisher": "electropol-fr",
    "version": "2026.8.0",
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "engines": {
        "vscode": "^1.42.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "Colored theme",
        "theme",
        "Arduino"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/FrankSAURET/colored-theme"
    },
    "contributes": {
        "themes": [
            {
                "label": "Colored Theme (China blue)",
                "uiTheme": "vs",
                "path": "./themes/Colorful/china-blue-color-theme.json"
            },
            {
                "label": "Colored Theme (Red)",
                "uiTheme": "vs",
                "path": "./themes/Colorful/red-color-theme.json"
            },
            {
                "label": "Colored Theme (Brown Auburn)",
                "uiTheme": "vs",
                "path": "./themes/Colorful/auburn-color-theme.json"
            },
            {
                "label": "Colored Theme (Yellow)",
                "uiTheme": "vs",
                "path": "./themes/Colorful/yellow-color-theme.json"
            },
            {
                "label": "Colored Theme (Green malachite)",
                "uiTheme": "vs",
                "path": "./themes/Colorful/green-malachite-color-theme.json"
            },
            {
                "label": "Colored Theme (Purple Amethyst)",
                "uiTheme": "vs",
                "path": "./themes/Colorful/amethyst-color-theme.json"
            },
            {
                "label": "Colored Theme (Brown Cognac)",
                "uiTheme": "vs",
                "path": "./themes/Colorful/cognac-color-theme.json"
            },
            {
                "label": "Colored Theme (Green Peacock)",
                "uiTheme": "vs",
                "path": "./themes/Colorful/peacock-color-theme.json"
            },
            {
                "label": "Colored Theme (Amber)",
                "uiTheme": "vs",
                "path": "./themes/Colorful/amber-color-theme.json"
            },
            {
                "label": "Colored Theme (Fushia)",
                "uiTheme": "vs",
                "path": "./themes/Colorful/fushia-color-theme.json"
            },
            {
                "label": "Colored Theme (Black)",
                "uiTheme": "vs-dark",
                "path": "./themes/Black/black-color-theme.json"
            },
            {
                "label": "Arduino light",
                "uiTheme": "vs",
                "path": "./themes/Colorful/Arduino-light-color-theme.json"
            },
            {
                "label": "Arduino dark",
                "uiTheme": "vs-dark",
                "path": "./themes/Black/Arduino-dark-color-theme.json"
            }
        ],
        "configuration": {
            "title": "Colored Theme",
            "properties": {
                "colored-theme.initializeLocalTheme": {
                    "type": "boolean",
                    "default": true,
                    "description": "Create a local theme setting for newly opened workspace folders."
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "vscode:prepublish": "npm run compile"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.42.0",
        "typescript": "^5.7.0"
    }
}
