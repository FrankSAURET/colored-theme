	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#a5a5a5"
			}
		},
		{
			"name": "Comments: Preprocessor",
			"scope": "comment.block.preprocessor",
			"settings": {
				"fontStyle": "",
				"foreground": "#a5a5a5"
			}
		},
		{
			"name": "Operators",
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#4472c4"
			}
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "storage"],
			"settings": {
				"foreground": "#4472c4"
			}
		},
		{
			"name": "Types",
			"scope": ["storage.type", "support.type"],
			"settings": {
				"foreground": "#8064a2"
			}
		},
		{
			"name": "Variables",
			"scope": ["variable", "support.variable"],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": {
				"foreground": "#5b9bd5"
			}
		},
		{
			"name": "Classes",
