  "tokenColors": [
    {
      "name": "",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Comments (line //)",
      "scope": ["comment.line", "punctuation.definition.comment.line"],
      "settings": {
        "foreground": "#434F54"
      }
    },
    {
      "name": "Comments (block /* */)",
      "scope": ["comment.block", "punctuation.definition.comment.block", "comment"],
      "settings": {
        "foreground": "#95A5A6"
      }
    },
    {
      "name": "Data types (KEYWORD1)",
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#D35400"
      }
    },
    {
      "name": "Functions and built-in classes (KEYWORD2)",
      "scope": [
        "support.function",
        "support.class",
        "entity.name.function",
        "meta.function-call.c",
        "meta.function.c"
      ],
      "settings": {
        "foreground": "#D35400"
      }
    },
    {
      "name": "Control keywords and preprocessor directives (KEYWORD3)",
      "scope": [
        "keyword.control",
        "keyword.control.directive",
        "meta.preprocessor.c",
        "entity.name.function.preprocessor.c"
      ],
      "settings": {
        "foreground": "#5E6D03"
      }
    },
    {
      "name": "Constants, booleans, numbers, char literals (LITERAL1/2)",
      "scope": [
        "constant.language",
        "constant.numeric",
        "constant.numeric.preprocessor.c",
        "string.quoted.single.c"
      ],
      "settings": {
        "foreground": "#00979C"
      }
    },
    {
      "name": "String literals",
      "scope": [
        "string.quoted.double",
        "string.quoted.other.lt-gt"
      ],
      "settings": {
        "foreground": "#e9ad09"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.section",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#35a2fa"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.name"
      ],
      "settings": {
        "foreground": "#6b08ad"
      }
    }
  ],
  "semanticTokenColors": {
    "macro": "#00979C"
  }
}